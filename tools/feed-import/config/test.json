{
  "feed": { "format": "csv", "source": "tests/sample-feed.csv", "delimiter": ",", "encoding": "UTF-8" },
  "mapping": {
    "sku": "SKU", "name": "ProductName", "description": "ShortDescription",
    "cost": "WholesalePrice", "map_price": "MAP", "quantity": "QtyAvailable",
    "ean13": "UPC", "weight": "ShipWeight", "category": "Category"
  },
  "pricing": {
    "tiers": [
      { "up_to": 10.0, "markup_percent": 140.0 },
      { "up_to": 25.0, "markup_percent": 110.0 },
      { "up_to": null, "markup_percent": 65.0 }
    ],
    "default_markup_percent": 65.0,
    "handling_fee": 0.0,
    "min_margin_amount": 4.0,
    "rounding": "charm"
  },
  "catalog": {
    "sku_prefix": "ACME-", "default_category_id": 2, "create_categories": true,
    "id_tax_rules_group": 0, "activate_new": true, "stock_buffer": 0,
    "disable_missing": true, "max_disable_ratio": 0.25
  },
  "runtime": { "log_dir": "var/log", "memory_limit": "512M" }
}
