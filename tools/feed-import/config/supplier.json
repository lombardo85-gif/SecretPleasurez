{
  "_comment": "Distributor XML feed (TABLE-RECORDS/EXPORT-RECORDS/PRODUCT). PRODUCTS_PRICE is the WHOLESALE cost, not retail. PRODUCTS_MODEL is the distributor SKU and is the upsert key.",

  "feed": {
    "format": "xml",
    "item_node": "PRODUCT",
    "source": "var/feeds/supplier-feed.xml",
    "encoding": "UTF-8",
    "timeout": 300
  },

  "mapping": {
    "sku": "PRODUCTS_MODEL",
    "name": "PRODUCTS_NAME",
    "description": "PRODUCTS_DESCRIPTION",
    "cost": "PRODUCTS_PRICE",
    "quantity": "PRODUCTS_QUANTITY",
    "ean13": "ITEM_UPC",
    "weight": "PRODUCTS_WEIGHT",
    "category": "PRODUCTS_TYPE",
    "brand": "ITEM_BRANDNAME"
  },

  "pricing": {
    "tiers": [
      { "up_to": 10.0, "markup_percent": 140.0 },
      { "up_to": 25.0, "markup_percent": 110.0 },
      { "up_to": 60.0, "markup_percent": 85.0 },
      { "up_to": null, "markup_percent": 65.0 }
    ],
    "default_markup_percent": 65.0,
    "handling_fee": 0.0,
    "min_margin_amount": 4.0,
    "rounding": "charm"
  },

  "catalog": {
    "default_category_id": 2,
    "create_categories": true,
    "id_tax_rules_group": 0,
    "activate_new": false,
    "ignore_brands": ["No Brand"],
    "stock_buffer": 2,
    "disable_missing": false,
    "max_disable_ratio": 0.25
  },

  "runtime": { "log_dir": "var/log", "memory_limit": "1024M" }
}
